							"path": ["api", "admin", "crud-permissions", "bulk", "RESELLER"]
						}
					}
				},
				{
					"name": "INDIVIDUAL: Change Specific Admin/Reseller by ID",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{superadmin_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"canCreate\": true,\r\n    \"canRead\": true,\r\n    \"canUpdate\": true,\r\n    \"canDelete\": true\r\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/crud-permissions/{{target_uuid}}",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "crud-permissions", "{{target_uuid}}"]
						}
					}
				}
			]
		},
