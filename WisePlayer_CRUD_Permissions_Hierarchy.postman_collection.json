		{
			"name": "2. Super Admin Panel (Manage All)",
			"description": "Super Admins can manage ADMIN, RESELLER, and SUB_RESELLER roles.",
			"item": [
				{
					"name": "BULK: Change All Admins (Role Defaults)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Authorization", "value": "Bearer {{superadmin_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"canCreate\": true,\r\n    \"canRead\": true,\r\n    \"canUpdate\": true,\r\n    \"canDelete\": false\r\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/crud-permissions/bulk/ADMIN",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "crud-permissions", "bulk", "ADMIN"]
						}
					}
				},
				{
					"name": "BULK: Change All Resellers (Role Defaults)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Authorization", "value": "Bearer {{superadmin_token}}"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"canCreate\": true,\r\n    \"canRead\": true,\r\n    \"canUpdate\": false,\r\n    \"canDelete\": false\r\n}"
