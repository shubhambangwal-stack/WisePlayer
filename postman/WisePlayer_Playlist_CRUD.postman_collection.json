{
	"info": {
		"_postman_id": "playlist-crud-collection-v1",
		"name": "WisePlayer — Playlist Full CRUD",
		"description": "Fully automated Postman collection to test all Playlist CRUD endpoints.\n\n## Setup Instructions\n1. Set `baseUrl` to your server (default: http://localhost:8080)\n2. Set `deviceFingerprint` to a valid registered & ACTIVE device fingerprint\n3. Set `publicDeviceId` to a device UUID or fingerprint for public endpoint tests\n4. Run **\"🔐 Auth — Validate Device\"** first to auto-populate the token\n5. Then run any folder or the entire collection in order\n\n## Auto-Chaining\n- Token is auto-saved from the auth request\n- Playlist IDs created in POST requests are auto-captured for GET/PUT/DELETE\n- All tests include status code + response structure validation",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "deviceFingerprint",
			"value": "YOUR_DEVICE_FINGERPRINT_HERE",
			"type": "string"
		},
		{
			"key": "deviceToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "deviceId",
			"value": "",
			"type": "string"
		},
		{
			"key": "publicDeviceId",
			"value": "YOUR_PUBLIC_DEVICE_ID_OR_FINGERPRINT",
			"type": "string"
		},
		{
			"key": "xtreamPlaylistId",
			"value": "",
			"type": "string"
		},
		{
			"key": "m3uPlaylistId",
			"value": "",
			"type": "string"
		},
		{
			"key": "publicM3uPlaylistId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🔐 Auth",
			"item": [
				{
					"name": "🔐 Validate Device (Get Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has token', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.token).to.be.a('string').and.not.empty;",
									"    pm.collectionVariables.set('deviceToken', json.token);",
									"    pm.collectionVariables.set('deviceId', json.deviceId);",
									"    console.log('✅ Token saved. DeviceId: ' + json.deviceId);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fingerprint\": \"{{deviceFingerprint}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/device/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "device", "validate"]
						},
						"description": "Validates a device and returns a JWT token. The token and deviceId are auto-saved to collection variables."
					}
				}
			],
			"description": "Run this first to authenticate and auto-populate the device token."
		},
