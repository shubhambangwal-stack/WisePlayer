{
	"info": {
		"_postman_id": "f5e92d8a-9f5b-43cc-8968-07f1f91d2931",
		"name": "IPTV Timeshift API Testing",
		"description": "Collection to verify secure IPTV Timeshift proxying and redirection functionality.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Register Device",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"X_DEVICE_TOKEN\", jsonData.token);",
							"pm.environment.set(\"X_DEVICE_FINGERPRINT\", \"postman-test-fingerprint-001\");",
							"pm.environment.set(\"DEVICE_SECRET\", jsonData.deviceSecret);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"deviceId\": \"postman-test-fingerprint-001\",\n    \"deviceModel\": \"Postman Runner\",\n    \"osVersion\": \"1.0.0\",\n    \"platform\": \"postman\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/device/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"device",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Generate Activation Key",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"ACTIVATION_KEY\", jsonData.activationKey);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"deviceId\": \"postman-test-fingerprint-001\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/device/key",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"device",
						"key"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Activate Device (Starts Trial & Sets Active Role)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Activation success is true\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"deviceId\": \"postman-test-fingerprint-001\",\n    \"activationKey\": \"{{ACTIVATION_KEY}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/device/activate",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"device",
						"activate"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Save Xtream Playlist",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"PLAYLIST_ID\", jsonData.data.id);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-Device-Token",
						"value": "{{X_DEVICE_TOKEN}}",
						"type": "text"
					},
					{
						"key": "X-Device-Fingerprint",
						"value": "{{X_DEVICE_FINGERPRINT}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Timeshift IPTV Playlist\",\n    \"serverUrl\": \"http://line.vpnworld.pro\",\n    \"username\": \"postmanuser\",\n    \"password\": \"postmanpass\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/playlist/xtream",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"playlist",
						"xtream"
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Secure Timeshift Redirect (Succeeds with 302/200)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Note: If 'Automatically follow redirects' is disabled in Postman Settings, pm.response will show 302 Found.",
							"// If enabled, Postman will follow redirect to http://line.vpnworld.pro/... and might show 404 or 200.",
							"pm.test(\"Verify redirection response status\", function () {",
							"    var expectedStatus = pm.response.code === 302 || pm.response.code === 200 || pm.response.code === 404;",
							"    pm.expect(expectedStatus).to.be.true;",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Device-Token",
						"value": "{{X_DEVICE_TOKEN}}",
						"type": "text"
					},
					{
						"key": "X-Device-Fingerprint",
						"value": "{{X_DEVICE_FINGERPRINT}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v2/stream/timeshift?playlistId={{PLAYLIST_ID}}&channelId=101&timestamp=2026-06-01T11:30:00&duration=60&extension=ts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v2",
						"stream",
						"timeshift"
					],
					"query": [
						{
							"key": "playlistId",
							"value": "{{PLAYLIST_ID}}"
						},
						{
							"key": "channelId",
							"value": "101"
						},
						{
							"key": "timestamp",
							"value": "2026-06-01T11:30:00"
						},
						{
							"key": "duration",
							"value": "60"
						},
						{
							"key": "extension",
							"value": "ts"
						}
					]
				}
			},
			"response": []
		},
		{
