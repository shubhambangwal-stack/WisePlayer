        },
        {
          "name": "Get All Playlists (No PIN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Device-Token",        "value": "{{token}}" },
              { "key": "X-Device-Fingerprint",  "value": "{{fingerprint}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/playlist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist"]
            }
          }
        },
        {
          "name": "Get All Playlists (With PIN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Device-Token",        "value": "{{token}}" },
              { "key": "X-Device-Fingerprint",  "value": "{{fingerprint}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/playlist?pin=1234",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist"],
              "query": [{ "key": "pin", "value": "1234" }]
            }
          }
        },
        {
          "name": "Get All Playlists (Default PIN 0000)",
          "request": {
            "method": "GET",
