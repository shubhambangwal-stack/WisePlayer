{
  "info": {
    "name": "WisePlayer - Complete Playlist Collection",
    "description": "Full coverage of every playlist endpoint. START with '0. Device Setup' to register and activate your device first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",           "value": "http://localhost:8081" },
    { "key": "token",             "value": "PASTE_DEVICE_TOKEN_HERE" },
    { "key": "fingerprint",       "value": "PASTE_RAW_FINGERPRINT_HERE" },
    { "key": "resellerToken",     "value": "PASTE_RESELLER_JWT_HERE" },
    { "key": "subResellerToken",  "value": "PASTE_SUB_RESELLER_JWT_HERE" },
    { "key": "deviceId",          "value": "DEVICE_MAC_OR_UUID" },
    { "key": "playlistId",        "value": "PLAYLIST_UUID_HERE" },
    { "key": "activationKey",     "value": "6_DIGIT_KEY_HERE" }
  ],
  "item": [

    {
      "name": "0. Device Setup (Run First!)",
      "description": "STEP 1: Register → STEP 2: Reseller Login → STEP 3: Generate Key → STEP 4: Activate → STEP 5: Validate (get token). After step 5, paste the token+fingerprint into collection variables.",
      "item": [
        {
          "name": "STEP 1 — Register Device",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.deviceId) {",
                  "  pm.collectionVariables.set('deviceId', json.data.deviceId);",
                  "  console.log('deviceId saved:', json.data.deviceId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"AA:BB:CC:DD:EE:FF\",\n  \"deviceModel\": \"Test Device\",\n  \"osVersion\": \"14.0\",\n  \"platform\": \"android\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/device/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "device", "register"]
            }
          }
        },
        {
          "name": "STEP 2 — Reseller Login (get resellerToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('resellerToken', json.data.token);",
                  "  console.log('resellerToken saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reseller@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reseller/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reseller", "login"]
            }
          }
        },
        {
          "name": "STEP 3 — Generate 6-Digit Activation Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.key) {",
                  "  pm.collectionVariables.set('activationKey', json.data.key);",
                  "  console.log('activationKey saved:', json.data.key);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{resellerToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"AA:BB:CC:DD:EE:FF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/device/key",
              "host": ["{{baseUrl}}"],
              "path": ["api", "device", "key"]
            }
          }
        },
        {
          "name": "STEP 4 — Activate Device with Key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"AA:BB:CC:DD:EE:FF\",\n  \"activationKey\": \"{{activationKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/device/activate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "device", "activate"]
            }
          }
        },
        {
          "name": "STEP 5 — Validate Device (get token + fingerprint)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  console.log('token saved');",
                  "}",
                  "// Set the raw fingerprint (the deviceId you registered with)",
                  "pm.collectionVariables.set('fingerprint', 'AA:BB:CC:DD:EE:FF');",
                  "console.log('fingerprint set to AA:BB:CC:DD:EE:FF');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"AA:BB:CC:DD:EE:FF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/device/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "device", "validate"]
            }
          }
        }
      ]
    },

    {
      "name": "1. Device — M3U Playlists (Authenticated)",
      "description": "Requires X-Device-Token + X-Device-Fingerprint headers. Device must be ACTIVE.",
      "item": [
        {
          "name": "Save M3U Playlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Device-Token",        "value": "{{token}}" },
              { "key": "X-Device-Fingerprint",  "value": "{{fingerprint}}" },
              { "key": "Content-Type",           "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My M3U Playlist\",\n  \"m3uUrl\": \"http://example.com/playlist.m3u\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/playlist/m3u",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist", "m3u"]
            }
          }
        },
        {
          "name": "Save M3U Playlist (with PIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Device-Token",        "value": "{{token}}" },
              { "key": "X-Device-Fingerprint",  "value": "{{fingerprint}}" },
              { "key": "Content-Type",           "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PIN Protected M3U\",\n  \"m3uUrl\": \"http://example.com/playlist.m3u\",\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/playlist/m3u",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist", "m3u"]
