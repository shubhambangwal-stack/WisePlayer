              { "key": "Content-Type",           "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Xtream Playlist\",\n  \"serverUrl\": \"http://xtream-server.com\",\n  \"username\": \"myuser\",\n  \"password\": \"mypass\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/playlist/xtream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist", "xtream"]
