{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "WisePlayer - SuperAdmin Admin CRUD Management API",
		"description": "Postman Collection for SuperAdmin to perform CRUD specifically on ADMIN role accounts (excluding RESELLER and SUB_RESELLER).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_SUPER_ADMIN_JWT_TOKEN",
			"type": "string"
		},
		{
			"key": "adminId",
			"value": "a3b8c9d0-1234-5678-9abc-def012345678",
			"type": "string"
		},
		{
			"key": "inviteToken",
			"value": "7f9e8d7c-6b5a-4321-9876-fedcba987654",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "SuperAdmin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"superadmin@example.com\",\n  \"password\": \"superadmin_password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin CRUD Management (role = ADMIN only)",
			"item": [
				{
					"name": "Get All Admins (role = ADMIN)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/all",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"all"
							]
						},
						"description": "Returns strictly accounts where role = ADMIN."
					},
					"response": []
				},
				{
					"name": "Get Admin By ID (role = ADMIN)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/{{adminId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"{{adminId}}"
							]
						},
						"description": "Retrieves an Admin by ID. Fails if the account is not role ADMIN."
					},
					"response": []
				},
				{
					"name": "Direct Create Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('adminId', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"john_admin\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"John Smith\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/create",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"create"
							]
						},
						"description": "Directly creates an account with role = ADMIN."
					},
					"response": []
				},
				{
					"name": "Invite Admin via Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('inviteToken', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newadmin@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/invite",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"invite"
							]
						}
					},
					"response": []
				},
				{
					"name": "Verify Invite Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/invite/verify?token={{inviteToken}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"invite",
								"verify"
							],
							"query": [
								{
									"key": "token",
									"value": "{{inviteToken}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Complete Setup from Invite",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{inviteToken}}\",\n  \"password\": \"MySecretPassword123!\",\n  \"fullName\": \"Sarah Connor\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/setup/complete",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"setup",
								"complete"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Admin (Details & CRUD Flags)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"john_updated\",\n  \"email\": \"john_new@example.com\",\n  \"fullName\": \"John Smith Updated\",\n  \"credits\": 500.00,\n  \"active\": true,\n  \"canCreate\": true,\n  \"canRead\": true,\n  \"canUpdate\": true,\n  \"canDelete\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/{{adminId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"{{adminId}}"
							]
						},
						"description": "Updates an Admin account details and CRUD permission flags."
					},
					"response": []
				},
				{
					"name": "Toggle Admin Active Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/{{adminId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"{{adminId}}",
								"status"
							]
						},
						"description": "Toggles active status of an Admin (true/false)."
					},
					"response": []
				},
				{
					"name": "Delete Admin",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/management/{{adminId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"management",
								"{{adminId}}"
							]
						},
						"description": "Deletes an Admin account."
					},
					"response": []
				}
			]
		}
	]
}
