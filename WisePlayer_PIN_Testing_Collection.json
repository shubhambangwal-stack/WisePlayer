{
  "info": {
    "name": "WisePlayer PIN Testing Collection",
    "description": "Collection to test Device and Playlist-level PIN functionality.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public Playlists",
      "item": [
        {
          "name": "Get Playlists with Valid PIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/playlist/public/{{deviceId}}?pin=1234",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist", "public", "{{deviceId}}"],
              "query": [
                {
                  "key": "pin",
                  "value": "1234"
                }
              ]
            }
          }
        },
        {
          "name": "Get Playlists with Default PIN (0000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/playlist/public/{{deviceId}}?pin=0000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist", "public", "{{deviceId}}"],
              "query": [
                {
                  "key": "pin",
                  "value": "0000"
                }
              ]
            }
          }
        },
        {
          "name": "Get Playlists without PIN (should use default 0000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/playlist/public/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist", "public", "{{deviceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Device Settings",
      "item": [
        {
          "name": "Set Device PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Token",
                "value": "{{token}}"
              },
              {
                "key": "X-Device-Fingerprint",
                "value": "{{fingerprint}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/device/pin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "device", "pin"],
              "query": [
                {
                  "key": "pin",
                  "value": "1234"
                }
              ]
            }
          }
        },
        {
          "name": "Remove Device PIN",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Device-Token",
                "value": "{{token}}"
              },
              {
                "key": "X-Device-Fingerprint",
                "value": "{{fingerprint}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/device/pin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "device", "pin"]
            }
          }
        }
      ]
    },
    {
      "name": "Authenticated Playlists",
      "item": [
        {
          "name": "Get Authenticated Playlists with PIN",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Device-Token",
                "value": "{{token}}"
              },
              {
                "key": "X-Device-Fingerprint",
                "value": "{{fingerprint}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/playlist?pin=1234",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist"],
              "query": [
                {
                  "key": "pin",
                  "value": "1234"
                }
              ]
            }
          }
        },
        {
          "name": "Get Authenticated Playlists with Default PIN",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Device-Token",
                "value": "{{token}}"
              },
              {
                "key": "X-Device-Fingerprint",
                "value": "{{fingerprint}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/playlist?pin=0000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "playlist"],
              "query": [
                {
                  "key": "pin",
                  "value": "0000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reseller Playlists",
      "item": [
        {
          "name": "Reseller Create M3U Playlist with PIN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{resellerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Sports\",\n  \"m3uUrl\": \"http://iptv-provider.com:8080/get.php?username=testuser&password=testpass&type=m3u_plus&output=ts\",\n  \"pin\": \"5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reseller/playlists/m3u",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reseller", "playlists", "m3u"]
            }
          }
        },
        {
          "name": "SubReseller Create M3U Playlist with PIN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{subResellerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Sports SubReseller\",\n  \"m3uUrl\": \"http://iptv-provider.com:8080/get.php?username=testuser2&password=testpass2&type=m3u_plus&output=ts\",\n  \"pin\": \"5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sub-reseller/playlists/m3u",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sub-reseller", "playlists", "m3u"]
            }
          }
        },
        {
          "name": "Reseller Create Xtream Playlist with PIN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{resellerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Xtream Sports\",\n  \"serverUrl\": \"http://iptv-provider.com:8080\",\n  \"username\": \"xtream_user\",\n  \"password\": \"xtream_pass\",\n  \"pin\": \"5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reseller/playlists/xtream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reseller", "playlists", "xtream"]
            }
          }
        },
        {
          "name": "SubReseller Create Xtream Playlist with PIN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{subResellerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Xtream Sports SubReseller\",\n  \"serverUrl\": \"http://iptv-provider.com:8080\",\n  \"username\": \"xtream_user2\",\n  \"password\": \"xtream_pass2\",\n  \"pin\": \"5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sub-reseller/playlists/xtream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sub-reseller", "playlists", "xtream"]
            }
          }
        },
        {
          "name": "❌ INVALID - M3U URL without m3u extension (should fail validation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{resellerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid Playlist\",\n  \"m3uUrl\": \"http://example.com/sports\",\n  \"pin\": \"5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reseller/playlists/m3u",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reseller", "playlists", "m3u"]
            }
          }
        },
        {
          "name": "❌ INVALID - Xtream URL with path (should fail validation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{resellerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid Xtream\",\n  \"serverUrl\": \"http://provider.com/panel/api.php\",\n  \"username\": \"user\",\n  \"password\": \"pass\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reseller/playlists/xtream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reseller", "playlists", "xtream"]
            }
          }
        },
        {
          "name": "❌ INVALID - PIN wrong format (should fail validation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{resellerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid PIN\",\n  \"m3uUrl\": \"http://iptv-provider.com:8080/get.php?type=m3u_plus\",\n  \"pin\": \"abc\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reseller/playlists/m3u",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reseller", "playlists", "m3u"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "deviceId",
      "value": "device_mac_or_id"
    },
    {
      "key": "token",
      "value": "jwt_token_here"
    },
    {
      "key": "resellerToken",
      "value": "jwt_reseller_token_here"
    },
    {
      "key": "subResellerToken",
      "value": "jwt_subreseller_token_here"
    },
    {
      "key": "fingerprint",
      "value": "device_fingerprint_here"
    }
  ]
}
