              "",
              "// Fix #2: Base64 decode",
              "const base64Regex = /^[A-Za-z0-9+/]+=*$/;",
              "const titles = programs.map(p => p.title).filter(Boolean);",
              "const base64Titles = titles.filter(t => t.length >= 8 && base64Regex.test(t) && !t.includes(' '));",
              "pm.test('Fix #2 — Titles are decoded (not raw Base64)', () => {",
              "    if (base64Titles.length > 0) console.error('Still Base64:', base64Titles.slice(0,3));",
              "    pm.expect(base64Titles.length).to.eql(0);",
              "});",
              "console.log('Sample titles:', titles.slice(0, 5));",
              "",
              "// At least one past programme with catchupAvailable=true",
              "const past = programs.find(p => p.catchupAvailable === true);",
              "pm.test('At least one past programme is catchupAvailable', () => pm.expect(past).to.be.ok);",
              "if (past) {",
              "    pm.collectionVariables.set('catchupStart', String(past.startTs));",
              "    pm.collectionVariables.set('catchupEnd',   String(past.endTs));",
              "    console.log('Past programme for catch-up playback:', past.title, past.startTs, '→', past.endTs);",
