{
  "info": {
    "name": "WisePlayer - Reseller Pricing Tiers",
    "description": "Fully automated Postman collection for testing Dynamic Reseller Pricing Tiers flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "seedSecret",
      "value": "YOUR_SEED_SECRET",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resellerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tierId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Admin & Seed",
      "item": [
        {
          "name": "Seed Initial Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Seed-Secret",
                "value": "{{seedSecret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/internal/seed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "internal",
                "seed"
              ]
            }
          }
        },
        {
          "name": "Super Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Has Token\", function () {",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.environment.set(\"adminToken\", jsonData.token);",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"superadmin\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Admin Tier Management",
      "item": [
        {
          "name": "Get All Tiers (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Is Array and not empty\", function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "    pm.collectionVariables.set(\"tierId\", jsonData[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/pricing-tiers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "pricing-tiers"
              ]
            }
          }
        },
        {
          "name": "Create New Tier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Has ID\", function () {",
                  "    pm.expect(jsonData.id).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TEST_TIER\",\n  \"minQuantity\": 2000,\n  \"maxQuantity\": 5000,\n  \"unitPrice\": 0.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/pricing-tiers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "pricing-tiers"
              ]
            }
          }
        },
        {
          "name": "Update Tier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"STANDARD_UPDATED\",\n  \"minQuantity\": 10,\n  \"maxQuantity\": 10,\n  \"unitPrice\": 2.45\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/pricing-tiers/{{tierId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "pricing-tiers",
                "{{tierId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Public Endpoints",
      "item": [
        {
          "name": "Get Public Tiers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Is Array and not empty\", function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/pricing/reseller-tiers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "pricing",
                "reseller-tiers"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Reseller Panel",
      "item": [
        {
          "name": "Reseller Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Has Token\", function () {",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.collectionVariables.set(\"resellerToken\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Test Reseller\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Tiers (Reseller Panel)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Is Array and not empty\", function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{resellerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reseller/credits/pricing-tiers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reseller",
                "credits",
                "pricing-tiers"
              ]
            }
          }
        },
        {
          "name": "Calculate Price (Single Quantity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{resellerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reseller/credits/pricing?quantity=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reseller",
                "credits",
                "pricing"
              ],
              "query": [
                {
                  "key": "quantity",
                  "value": "50"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
