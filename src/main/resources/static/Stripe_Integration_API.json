{
	"info": {
		"_postman_id": "d1e2f3a4-b5c6-4d7e-8f9a-0b1c2d3e4f5a",
		"name": "WisePlayer Stripe Integration API",
		"description": "Collection of Stripe-specific endpoints for the WisePlayer IPTV management system, including checkout session creation and manual webhook simulation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Checkout",
			"item": [
				{
					"name": "Create Stripe Checkout Session",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"deviceId\": \"{{deviceFingerprint}}\",\n    \"plan\": \"ANNUAL\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/payment/checkout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"payment",
								"checkout"
							]
						},
						"description": "Initiates a Stripe Checkout session. The response will contain a 'url' to redirect the user to Stripe's hosted payment page."
					},
					"response": []
				}
			]
		},
		{
			"name": "Webhooks",
			"item": [
				{
					"name": "Simulate Stripe Webhook (checkout.session.completed)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Stripe-Signature",
								"value": "t=123,v1=abc",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"evt_123\",\n  \"object\": \"event\",\n  \"api_version\": \"2023-10-16\",\n  \"created\": 1700000000,\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_123\",\n      \"object\": \"checkout.session\",\n      \"amount_total\": 4999,\n      \"currency\": \"usd\",\n      \"customer_details\": {\n        \"email\": \"customer@example.com\"\n      },\n      \"metadata\": {\n        \"deviceId\": \"{{deviceFingerprint}}\",\n        \"plan\": \"ANNUAL\"\n      },\n      \"payment_status\": \"paid\",\n      \"status\": \"complete\"\n    }\n  },\n  \"type\": \"checkout.session.completed\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/payment/webhook",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"payment",
								"webhook"
							]
						},
						"description": "Simulate a Stripe webhook call. Note: The current implementation has the Stripe webhook disabled."
					},
					"response": []
				}
			]
		},
		{
			"name": "Invoices",
			"item": [
				{
					"name": "Get All Invoices",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/payment/invoices?deviceId={{deviceFingerprint}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"payment",
								"invoices"
							],
							"query": [
								{
									"key": "deviceId",
									"value": "{{deviceFingerprint}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Current Active Invoice",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/payment/invoice/current?deviceId={{deviceFingerprint}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"payment",
								"invoice",
								"current"
							],
							"query": [
								{
									"key": "deviceId",
									"value": "{{deviceFingerprint}}"
								}
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "deviceFingerprint",
			"value": "YOUR_DEVICE_FINGERPRINT",
			"type": "string"
		}
	]
}
