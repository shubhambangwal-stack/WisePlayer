            },
            "url": { "raw": "{{baseUrl}}/api/reseller/playlists/{{resellerPlaylistId}}", "host": ["{{baseUrl}}"], "path": ["api","reseller","playlists","{{resellerPlaylistId}}"] }
          }
        },
        {
