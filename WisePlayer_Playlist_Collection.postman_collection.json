            "url": { "raw": "{{baseUrl}}/api/reseller/playlists/{{resellerPlaylistId}}/assign", "host": ["{{baseUrl}}"], "path": ["api","reseller","playlists","{{resellerPlaylistId}}","assign"] }
          }
        },
        {
