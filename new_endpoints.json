            "value": "Bearer <YOUR_ADMIN_TOKEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/support/tickets?status=OPEN&page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "support",
            "tickets"
          ],
          "query": [
            {
              "key": "status",
              "value": "OPEN"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
