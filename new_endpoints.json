{
  "info": {
    "name": "WisePlayer New Endpoints (Support & Transactions)",
    "description": "API collection for the newly added Public Support Helpdesk and Reseller Transaction History features.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Reseller Transaction History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <YOUR_RESELLER_TOKEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reseller/credits/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reseller",
            "credits",
            "transactions"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Submit Public Support Ticket",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "firstName",
              "value": "John",
              "type": "text"
            },
            {
              "key": "lastName",
              "value": "Doe",
              "type": "text"
            },
            {
              "key": "email",
              "value": "john.doe@example.com",
              "type": "text"
            },
            {
              "key": "macAddress",
              "value": "00:1A:2B:3C:4D:5E",
              "type": "text"
            },
            {
              "key": "inquiryType",
              "value": "TECHNICAL_ISSUE",
              "type": "text"
            },
            {
              "key": "message",
              "value": "I am experiencing buffer issues when trying to watch live streams.",
              "type": "text"
            },
            {
              "key": "attachment",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/public/support/ticket",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "public",
            "support",
            "ticket"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Admin - Get All Support Tickets",
      "request": {
        "method": "GET",
        "header": [
          {
