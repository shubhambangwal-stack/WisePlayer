    {
      "name": "── STEP 3: GET Content (Progress Auto-Embedded) ──",
      "item": [
        {
          "name": "Get VOD Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const list = Array.isArray(json) ? json : (json.data || []);",
                  "pm.test('VOD categories returned', () => pm.expect(list.length).to.be.at.least(1));",
                  "if (list[0]) {",
                  "    pm.collectionVariables.set('categoryId', String(list[0].category_id));",
                  "    console.log('Category selected:', list[0].category_name, '->', list[0].category_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Device-Token",
                "value": "{{deviceToken}}",
                "type": "text"
              },
              {
                "key": "X-Device-Fingerprint",
                "value": "{{deviceFingerprint}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/movie?playlistId={{playlistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movie"
