          "name": "Get VOD Streams (with watch_progress embedded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const list = Array.isArray(json) ? json : (json.data || []);",
                  "pm.test('VOD streams returned', () => pm.expect(list.length).to.be.at.least(1));",
                  "const watched = list.filter(s => s.watch_progress && s.watch_progress.resume_position_seconds > 0);",
                  "console.log('Total streams:', list.length, '| With resume position:', watched.length);",
                  "watched.forEach(s => console.log('  📼', s.name, '→ resume at', s.watch_progress.resume_position_seconds, 's'));"
                ]
              }
            }
