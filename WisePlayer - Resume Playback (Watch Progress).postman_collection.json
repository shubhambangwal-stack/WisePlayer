        {
          "name": "✅ Save Progress - Fully Watched (≥95% → resets to 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Progress saved (200)', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('fully_watched is TRUE when ≥95% watched', () => {",
                  "    pm.expect(json.fully_watched).to.eql(true);",
                  "});",
                  "pm.test('resume_position_seconds resets to 0 on full watch', () => {",
                  "    pm.expect(json.resume_position_seconds).to.eql(0);",
                  "});",
                  "console.log('✅ Fully watched! resume_position_seconds should be 0:', json.resume_position_seconds);"
                ]
              }
            }
          ],
