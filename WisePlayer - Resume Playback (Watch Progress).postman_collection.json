        {
          "name": "Get Series Info + Episodes (with watch_progress embedded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Series info returned', () => pm.expect(json).to.be.ok);",
                  "const seasons = json.episodes || {};",
                  "const allEpisodes = Object.values(seasons).flat();",
                  "const watchedEps = allEpisodes.filter(e => e.watch_progress && e.watch_progress.resume_position_seconds > 0);",
                  "console.log('Total episodes:', allEpisodes.length, '| With resume position:', watchedEps.length);",
                  "watchedEps.forEach(e => console.log('  📺 Ep', e.episode_num, '→ resume at', e.watch_progress.resume_position_seconds, 's | fully_watched:', e.watch_progress.fully_watched));"
                ]
              }
            }
