{
	"info": {
		"_postman_id": "4e1f7c32-1596-41b2-bf96-9812480373df",
		"name": "WisePlayer CRUD Permissions",
		"description": "Collection for testing centralized CRUD Permissions (Bulk and Individual) across roles.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication (Tokens)",
			"item": [
				{
					"name": "Super Admin Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"username\": \"superadmin\",\r\n    \"password\": \"superadmin123\"\r\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/superadmin/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"superadmin",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Admin Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"username\": \"admin_user\",\r\n    \"password\": \"password123\"\r\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Reseller Login",
